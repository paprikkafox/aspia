         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="checkbox_allow_local_fallback">
         <property name="text">
          <string>Fall back to a local account when LDAP cannot decide (LDAP preferred)</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QFormLayout" name="form_advanced">
         <item row="0" column="0">
