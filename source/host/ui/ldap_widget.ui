<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>LdapWidget</class>
 <widget class="QWidget" name="LdapWidget">
  <layout class="QVBoxLayout" name="verticalLayout_root">
   <item>
    <widget class="QCheckBox" name="checkbox_enabled">
     <property name="text">
      <string>Enable LDAP authentication</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QTabWidget" name="tab_widget">
     <widget class="QWidget" name="tab_connection">
      <attribute name="title">
       <string>Connection</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_connection">
       <item>
        <layout class="QFormLayout" name="form_connection">
         <item row="0" column="0">
          <widget class="QLabel" name="label_server">
           <property name="text">
            <string>Server:</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QLineEdit" name="edit_server"/>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="label_port">
           <property name="text">
            <string>Port:</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="QSpinBox" name="spinbox_port">
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>65535</number>
           </property>
           <property name="value">
            <number>636</number>
           </property>
          </widget>
         </item>
         <item row="2" column="0">
          <widget class="QLabel" name="label_security">
           <property name="text">
            <string>Security:</string>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="QComboBox" name="combobox_security"/>
         </item>
         <item row="3" column="1">
          <widget class="QCheckBox" name="checkbox_verify_peer">
           <property name="text">
            <string>Verify the server certificate</string>
           </property>
           <property name="checked">
            <bool>true</bool>
           </property>
          </widget>
         </item>
         <item row="4" column="0">
          <widget class="QLabel" name="label_ca_certificate">
           <property name="text">
            <string>CA certificate:</string>
           </property>
          </widget>
         </item>
         <item row="4" column="1">
          <widget class="QPushButton" name="button_ca_certificate">
           <property name="text">
            <string>Not set</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_test">
         <item>
          <widget class="QPushButton" name="button_test">
           <property name="text">
            <string>Test connection</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="button_check_login">
           <property name="text">
            <string>Check login...</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="horizontalSpacer_test">
           <property name="orientation">
            <enum>Qt::Orientation::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>
       <item>
        <spacer name="verticalSpacer_connection">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tab_bind">
      <attribute name="title">
       <string>Bind / search</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_bind">
       <item>
        <layout class="QFormLayout" name="form_bind">
         <item row="0" column="0">
          <widget class="QLabel" name="label_bind_dn">
           <property name="text">
            <string>Bind DN:</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QLineEdit" name="edit_bind_dn"/>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="label_bind_password">
           <property name="text">
            <string>Bind password:</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="PasswordEdit" name="edit_bind_password"/>
         </item>
         <item row="2" column="0">
          <widget class="QLabel" name="label_base_dn">
           <property name="text">
            <string>User base DN:</string>
           </property>
