     <widget class="QWidget" name="tab_advanced">
      <attribute name="title">
       <string>Advanced</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_advanced">
       <item>
        <widget class="QGroupBox" name="groupbox_default_sessions">
         <property name="title">
          <string>Rights when no mapping matches</string>
         </property>
         <layout class="QHBoxLayout" name="horizontalLayout_default">
          <item>
           <widget class="QCheckBox" name="checkbox_default_desktop">
            <property name="text">
             <string>Desktop</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="checkbox_default_terminal">
            <property name="text">
             <string>Terminal</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="checkbox_default_file_transfer">
            <property name="text">
             <string>Files</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="checkbox_default_system_info">
            <property name="text">
             <string>System</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="checkbox_default_chat">
            <property name="text">
             <string>Chat</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="checkbox_deny_if_unmapped">
         <property name="text">
          <string>Deny when no mapping matches (ignore the default rights)</string>
