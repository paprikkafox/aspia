          </widget>
         </item>
         <item row="4" column="1">
          <widget class="QLineEdit" name="edit_user_name_attribute"/>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QLabel" name="label_bind_hint">
         <property name="text">
          <string>Leave the bind DN empty to connect anonymously.</string>
